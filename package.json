{
  "name": "roblox-ts-project-template-2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "assets:upload": "asphalt sync && mv src/shared/constants/images/images.luau src/shared/constants/images/init.luau  && mv src/shared/constants/images/images.d.ts src/shared/constants/images/index.d.ts && eslint src/shared/constants/images/index.d.ts --fix ",
    "clean": "rimraf out/ && rimraf dist && rimraf flamework.build",
    "darklua": "darklua process out dist --verbose",
    "dev:build": "rbxts-build build",
    "dev:compile": "rbxts-build compile",
    "dev:open": "rbxts-build open",
    "dev:reopen": "pnpm dev:stop && pnpm dev:open",
    "dev:restart": "pnpm dev:stop && pnpm dev:start",
    "dev:start": "rbxts-build start",
    "dev:stop": "rbxts-build stop",
    "dev:sync": "rbxts-build sync && eslint src/types/interfaces/services.d.ts --fix",
    "dev:test": "pnpm dev:build && run-in-roblox --place game.rbxl --script out/test/runtime.server.luau",
    "dev:cloud_test": "lune run tests/init.luau",
    "dev:watch": "rbxts-build watch",
    "lint": "eslint src",
    "prepare": "cp patches/TestEZ_Companion.rbxm $LOCALAPPDATA/Roblox/Plugins/",
    "prod:build": "pnpm clean && NODE_ENV=production && rbxtsc --verbose && pnpm darklua",
    "prod:sync": "rojo serve ./build.project.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "1.0.906",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-roblox-ts": "1.4.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "rbxts-build": "github:AndalYLP/rbxts-build#add-custom-definition-for-sync-command",
    "rbxts-transform-env": "3.0.0",
    "rbxts-transformer-flamework": "1.3.2",
    "rbxts-transformer-inline": "1.2.71",
    "rimraf": "6.1.3",
    "roblox-ts": "3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "dependencies": {
    "@flamework/components": "1.3.2",
    "@flamework/core": "1.3.2",
    "@flamework/networking": "1.3.2",
    "@rbxts/centurion": "1.0.1",
    "@rbxts/centurion-ui": "1.0.8",
    "@rbxts/charm": "0.11.0",
    "@rbxts/charm-sync": "0.4.0",
    "@rbxts/janitor": "1.18.3-ts.0",
    "@rbxts/jest": "3.13.3-ts.1",
    "@rbxts/jest-globals": "3.13.3-ts.2",
    "@rbxts/lapis": "0.3.8",
    "@rbxts/lapis-mockdatastore": "0.3.7",
    "@rbxts/lemon-signal": "1.2.0",
    "@rbxts/log": "0.6.3",
    "@rbxts/make": "1.0.6",
    "@rbxts/pretty-vide-utils": "0.0.5",
    "@rbxts/ripple": "0.10.2",
    "@rbxts/services": "1.6.0",
    "@rbxts/set-timeout": "1.1.2",
    "@rbxts/sift": "0.0.11",
    "@rbxts/t": "3.2.1",
    "@rbxts/ui-labs": "2.4.2",
    "@rbxts/validate-tree": "2.0.2",
    "@rbxts/vide": "0.6.1",
    "@rbxts/vide-charm": "0.4.0",
    "@rbxts/vide-ripple": "0.10.2",
    "@rbxts/zone-plus": "3.2.0"
  },
  "pnpm": {
    "overrides": {
      "@rbxts/vide": "0.6.1"
    },
    "patchedDependencies": {
      "@rbxts/charm@0.11.0": "patches/@rbxts__charm@0.11.0.patch",
      "@rbxts/charm-sync@0.4.0": "patches/@rbxts__charm-sync@0.4.0.patch"
    }
  },
  "rbxts-build": {
    "syncLocation": "src/types/interfaces/services.d.ts",
    "customDefinitionsLocation": "src/types/interfaces/custom-definitions.d.ts",
    "names": {
      "build": "dev:build",
      "compile": "dev:compile",
      "open": "dev:open",
      "watch": "dev:watch"
    }
  }
}
